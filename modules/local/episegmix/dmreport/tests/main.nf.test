// nf-core modules test episegmix/dmreport
nextflow_process {

    name "Test Process EPISEGMIX_DMREPORT"
    script "../main.nf"
    process "EPISEGMIX_DMREPORT"

    tag "modules"
    tag "modules_episegmix"
    tag "episegmix"
    tag "episegmix/dmreport"

    test("GM12878 - EPISEGMIX_DMREPORT") {

        when {
            process {
                """
                input[0] = [
                    'GM12878_2',
                    [
                        [
                            id: 'GM12878',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    file("${projectDir}/assets/testdata/results_dm/Counts/GM12878_Histone/GM12878.tab", checkIfExists: true),
                    [ id: 'GM12878', epigenetic_mark: 'WGBS', distribution: 'BB' ],
                    file("${projectDir}/assets/testdata/results_dm/Counts/GM12878_Methylation/GM12878_meth.tab", checkIfExists: true),
                    2,
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts-meth.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/final-model-GM12878_2.json", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Segmentation", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("GM12878 - EPISEGMIX_DMREPORT - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'GM12878_2',
                    [
                        [
                            id: 'GM12878',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    file("${projectDir}/assets/testdata/results_dm/Counts/GM12878_Histone/GM12878.tab", checkIfExists: true),
                    [ id: 'GM12878', epigenetic_mark: 'WGBS', distribution: 'BB' ],
                    file("${projectDir}/assets/testdata/results_dm/Counts/GM12878_Methylation/GM12878_meth.tab", checkIfExists: true),
                    2,
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts-meth.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Model/final-model-GM12878_2.json", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dm/EpiSegMix/GM12878_2/Segmentation", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
