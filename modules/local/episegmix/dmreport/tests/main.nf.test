// nf-core modules test episegmix/dmreport
nextflow_process {

    name "Test Process EPISEGMIX_DMREPORT"
    script "../main.nf"
    process "EPISEGMIX_DMREPORT"

    tag "modules"
    tag "modules_episegmix"
    tag "episegmix"
    tag "episegmix/dmreport"

    test("Kidney - EPISEGMIX_DMREPORT") {

        when {
            process {
                """
                input[0] = [
                    'kidney_P0_2',
                    [
                        [
                            id: 'kidney_P0',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    file("${projectDir}/assets/testdata/kidney_P0.tab", checkIfExists: true),
                    [ id: 'no_bed_counts' ],
                    [],
                    2,
                    file("${projectDir}/assets/testdata/kidney_P0_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-counts-meth.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/dm/final-model-kidney_P0_2.json", checkIfExists: true),
                    file("${projectDir}/assets/testdata/ldm/Segmentation", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - EPISEGMIX_DMREPORT - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'kidney_P0_2',
                    [
                        [
                            id: 'kidney_P0',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    file("${projectDir}/assets/testdata/kidney_P0.tab", checkIfExists: true),
                    [ id: 'no_bed_counts' ],
                    [],
                    2,
                    file("${projectDir}/assets/testdata/kidney_P0_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/kidney_P0_2-train-counts-meth.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/dm/final-model-kidney_P0_2.json", checkIfExists: true),
                    file("${projectDir}/assets/testdata/ldm/Segmentation", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
