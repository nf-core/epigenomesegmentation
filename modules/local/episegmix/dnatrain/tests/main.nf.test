// nf-core modules test episegmix/dnatrain
nextflow_process {

    name "Test Process EPISEGMIX_DNATRAIN"
    script "../main.nf"
    process "EPISEGMIX_DNATRAIN"

    tag "modules"
    tag "modules_episegmix"
    tag "episegmix"
    tag "episegmix/dnatrain"

    test("GM12878 - EPISEGMIX_DNATRAIN") {

        when {
            process {
                """
                input[0] = [
                    'GM12878_2',
                    [ id: 'no_bam_counts' ],
                    [],
                    [
                        id: 'GM12878',
                        replicate: 1,
                        epigenetic_mark: 'WGBS',
                        modality: 'WGBS',
                        paired_end: true,
                        distribution: 'BI'
                    ],
                    file("${projectDir}/assets/testdata/results_dna/Counts/GM12878_Methylation/GM12878_WGBS_binnedbedcounts.bed", checkIfExists: true),
                    2,
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/dummy-train-counts-meth.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("GM12878 - EPISEGMIX_DNATRAIN - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'GM12878_2',
                    [ id: 'no_bam_counts' ],
                    [],
                    [
                        id: 'GM12878',
                        replicate: 1,
                        epigenetic_mark: 'WGBS',
                        modality: 'WGBS',
                        paired_end: true,
                        distribution: 'BI'
                    ],
                    file("${projectDir}/assets/testdata/results_dna/Counts/GM12878_Methylation/GM12878_WGBS_binnedbedcounts.bed", checkIfExists: true),
                    2,
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2.yaml", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2-train-counts.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/GM12878_2-train-regions.txt", checkIfExists: true),
                    file("${projectDir}/assets/testdata/results_dna/EpiSegMix/GM12878_2/Model/dummy-train-counts-meth.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
