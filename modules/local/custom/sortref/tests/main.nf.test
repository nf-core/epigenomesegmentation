// nf-core modules test custom/sortref
nextflow_process {

    name "Test Process CUSTOM_SORTREF"
    script "../main.nf"
    process "CUSTOM_SORTREF"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/sortref"

    test("mm10 - SORTREF") {

        when {
            process {
                """
                input[0] = [
                    'hg38',
                    file("${projectDir}/assets/testdata/results_ldm/References/hg38/filtered_hg38_chr12_chr13.chrom.sizes.v2", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("mm10 - SORTREF - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'hg38',
                    file("${projectDir}/assets/testdata/results_ldm/References/hg38/filtered_hg38_chr12_chr13.chrom.sizes.v2", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
