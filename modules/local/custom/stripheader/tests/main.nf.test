// nf-core modules test custom/stripheader
nextflow_process {

    name "Test Process CUSTOM_STRIPHEADER"
    script "../main.nf"
    process "CUSTOM_STRIPHEADER"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/stripheader"

    test("Kidney - STRIPHEADER") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'GM12878' ],
                    file("${projectDir}/assets/testdata/results_ldm/Counts/GM12878_Histone/GM12878.tab", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - STRIPHEADER - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'GM12878' ],
                    file("${projectDir}/assets/testdata/results_ldm/Counts/GM12878_Histone/GM12878.tab", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
