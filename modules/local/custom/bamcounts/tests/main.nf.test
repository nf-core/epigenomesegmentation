// nf-core modules test custom/bamcounts
nextflow_process {

    name "Test Process CUSTOM_BAMCOUNTS"
    script "../main.nf"
    process "CUSTOM_BAMCOUNTS"

    tag "modules"
    tag "modules_"
    tag "custom"
    tag "custom/bamcounts"

    test("Kidney - BAMCOUNTS") {

        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the nf-test docs (https://www.nf-test.com/docs/testcases/setup/).

    when {
        process {
                """
                input[0] = [
                    'GM12878',
                    [
                        id: 'GM12878',
                        replicate: 1,
                        epigenetic_mark: 'H3K27me3',
                        modality: 'ChIP-seq',
                        paired_end: false,
                        distribution: 'NBI'
                    ],
                    file("${projectDir}/assets/testdata/results_ldm/Counts/GM12878_Histone/GM12878.txt", checkIfExists: true),
                    [
                        file("${projectDir}/assets/testdata/bamcounts/ENCFF633BHN_chr12_chr13.nochr.bam", checkIfExists: true),
                        file("${projectDir}/assets/testdata/bamcounts/ENCFF911YNM_chr12_chr13.nochr.bam", checkIfExists: true)
                    ]
                ]

                input[1] = [
                    'hg38',
                    file("${projectDir}/assets/testdata/results_ldm/References/hg38/filtered_hg38_chr12_chr13.chrom.sizes.v2", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
                // See https://nf-co.re/docs/developing/testing/assertions for more information and examples.
            )
        }

    }

    test("Kidney - BAMCOUNTS - stub") {

            options "-stub"

            when {
                process {
                    """
                    input[0] = [
                        'GM12878',
                        [
                            id: 'GM12878',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ],
                        file("${projectDir}/assets/testdata/results_ldm/Counts/GM12878_Histone/GM12878.txt", checkIfExists: true),
                        [
                            file("${projectDir}/assets/testdata/bamcounts/ENCFF633BHN_chr12_chr13.nochr.bam", checkIfExists: true),
                            file("${projectDir}/assets/testdata/bamcounts/ENCFF911YNM_chr12_chr13.nochr.bam", checkIfExists: true)
                        ]
                    ]

                    input[1] = [
                        'hg38',
                        file("${projectDir}/assets/testdata/results_ldm/References/hg38/filtered_hg38_chr12_chr13.chrom.sizes.v2", checkIfExists: true)
                    ]
                    """
                }
            }

            then {
                assert process.success
                assertAll(
                    { assert snapshot(process.out).match() }
                )
            }

        }

}
